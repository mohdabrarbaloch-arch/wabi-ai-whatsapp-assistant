{
  "name": "wabi-ai-whatsapp-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "Wabi — AI WhatsApp Business Assistant. Auto-replies, lead capture, knowledge base, human handoff.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node scripts/prepare-db.mjs && next build",
    "build:local": "prisma generate --schema prisma/schema.prisma && next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "next lint --dir app --dir components --dir lib",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "db:gen": "prisma generate --schema prisma/schema.prisma",
    "pg:gen": "node scripts/gen-pg-schema.mjs && prisma generate --schema prisma/schema.postgres.prisma",
    "pg:push": "node scripts/gen-pg-schema.mjs && prisma db push --schema prisma/schema.postgres.prisma"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^16.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.47",
    "prisma": "^5.19.1",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}