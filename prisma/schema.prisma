// Wabi — Prisma schema (SQLite for local dev; switch datasource url to
// postgresql in production — the same schema works for both).
// Note: SQLite has no native enums, so state/role fields are String with
// app-level constants in lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String
  passwordHash  String
  plan          String     @default("free") // free | pro | growth
  whatsappPhoneId String?
  waConnected   Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  business      Business?
  contacts      Contact[]
  conversations Conversation[]
  knowledge     KnowledgeItem[]
  aiMessages    AiMessageLog[]
}

model Business {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String
  category  String?
  timezone  String   @default("Asia/Karachi")
  welcomeMessage String @default("Hi! 👋 Thanks for reaching out to us. How can we help you today?")
  botEnabled Boolean  @default(true)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KnowledgeItem {
  id        String   @id @default(cuid())
  userId    String
  question  String
  answer    String
  keywords  String   @default("")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Contact {
  id         String   @id @default(cuid())
  userId     String
  waPhone    String   @unique
  name       String?
  leadScore  Int      @default(0)
  leadStatus String   @default("new") // new | qualified | converted | not_a_lead
  lastMessageAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  @@index([userId])
}

model Conversation {
  id         String   @id @default(cuid())
  userId     String
  contactId  String
  status     String   @default("open") // open | closed
  mode       String   @default("ai")   // ai | human
  leadScore  Int      @default(0)
  leadStatus String   @default("new")
  summary    String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages   Message[]
  @@index([userId, updatedAt])
}

model Message {
  id        String   @id @default(cuid())
  conversationId String
  role      String // customer | assistant | agent (human)
  body      String
  createdAt DateTime @default(now())
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}

model AiMessageLog {
  id        String   @id @default(cuid())
  userId    String
  kind      String   // auto_reply | summary | suggestion
  provider  String   // openai | gemini | offline
  status    String   // ok | fallback | error
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}